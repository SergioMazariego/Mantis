# Allowlist: nothing at the repository root is tracked unless listed here.
# Keep in sync with ALLOW in tools/check_public_tree.py (CI and pre-push enforce it).
/*
!/.github/
!/assets/
!/.githooks/
!/.gitignore
!/.goreleaser.yaml
!/LICENSE.txt
!/README.md
!/mantis.go
!/tools/
!/v2/

# Never track, even inside allowed directories
/v2/dist/
/dist/
/bin/
__pycache__/
*.pyc
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.zip
*.7z
*.rar
*.pdf
*.docx
*.exe

# Forensic evidence and local case stores
*.mantis
*.evtx
*.E01
*.raw
*.dd
*.vhdx
*.sqlite
*.sqlite.sha256
*.migration.lock
*.sqlite3
*.db
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
*.db-wal
*.db-shm
*.db-journal
*.log
Artifacts/
case-data/
testdata/private/
